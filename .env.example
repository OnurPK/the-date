# Copy to .env (gitignored). Restart dev-server after editing.
OPENAI_API_KEY=
# Freepik / Magnific image generation (Mystic)
FREEPIK_API_KEY=
# Only needed for async webhooks (not used on localhost — we poll)
FREEPIK_WEBHOOK_SECRET=
# Optional: FREEPIK_API_BASE=https://api.magnific.com   (default https://api.freepik.com)
# Optional: FREEPIK_MYSTIC_MODEL=realism|fluid|zen|flexible|super_real|editorial_portraits
# Optional: FREEPIK_RESOLUTION=1k|2k|4k
# Higgsfield (console.higgsfield.ai → API key). Single value; if the console shows an ID + secret, use HF_API_KEY_ID / HF_API_KEY_SECRET instead.
HF_API_KEY=
# HF_API_KEY_ID=
# HF_API_KEY_SECRET=
