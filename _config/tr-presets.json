{
  "_comment": "Transition packages referenced from script directives like [tr:fadeUp]. Each preset is either type:'css' (single keyframe-style animation on a target) or type:'sequence' (multiple steps with optional delays + optional loop). Targets: char-active, char-incoming, background, dialog-box, bubble.",

  "none": {
    "type": "none"
  },

  "fadeUp": {
    "_label": "Fade in + slide up",
    "type": "css",
    "target": "dialog-box",
    "from": { "opacity": 0, "transform": "translateY(20px)" },
    "to":   { "opacity": 1, "transform": "translateY(0)" },
    "duration_ms": 600,
    "easing": "ease-out"
  },

  "softCrossfade": {
    "_label": "Soft cross-fade between backgrounds",
    "type": "css",
    "target": "background",
    "from": { "opacity": 0 },
    "to":   { "opacity": 1 },
    "duration_ms": 900,
    "easing": "ease-in-out"
  },

  "charSwap": {
    "_label": "Active character exits, new one enters, bg pans",
    "type": "sequence",
    "loop": false,
    "steps": [
      { "target": "char-active",   "anim": "exit-left",   "duration_ms": 400 },
      { "target": "char-incoming", "anim": "enter-right", "duration_ms": 400, "delay_ms": 200 },
      { "target": "background",    "anim": "pan-right",   "duration_ms": 800 }
    ]
  },

  "innerVoiceLoop": {
    "_label": "Inner-voice characters cycling — pulses background pan",
    "type": "sequence",
    "loop": true,
    "steps": [
      { "target": "char-active",   "anim": "exit-left",   "duration_ms": 350 },
      { "target": "char-incoming", "anim": "enter-right", "duration_ms": 350, "delay_ms": 150 },
      { "target": "background",    "anim": "pan-slow",    "duration_ms": 1200 }
    ]
  }
}
