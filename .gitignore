# Local config — only files with secrets stay private. We DO NOT
# ignore the whole _config/ folder, because git's `!negation` rule
# can't re-include files inside an ignored directory. Instead each
# secret file is listed by name; everything else (fx/tr preset
# JSONs etc.) gets committed normally.
_config/api.js
_config/worker.js
_config/*.bak
_config/*.local.*
*.action-backup
*.backup
*.backup-music

# Session working backups + scratch (added when pushing P&P work)
*.bak-*
*.before-nodes
_to_delete/
**/_to_delete/

# Docs / scratch / experiments — not part of the game
_docs/jira-backlog.html
mockups/
zoom-transitions.html
worlds/london/locations/deneme2/
worlds/london/locations/deneme3/

